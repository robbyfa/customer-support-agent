# =============================================================================
# Customer Support Resolution Copilot - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# --- OpenAI ---
# Required: your OpenAI API key
OPENAI_API_KEY=your-openai-api-key-here

# Optional: model to use (default: gpt-4o-mini)
MODEL_NAME=gpt-4o-mini

# --- LangSmith Tracing (optional) ---
# Set to "true" to enable LangSmith tracing. Requires a valid API key.
# If disabled or key is missing, the copilot still works - tracing is skipped.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=customer-support-copilot
